    lastmod: 1760303908338
    events:
      - eventKey: OnRoomStart
        code: |
          let createRed = templates.copy("UIButton", 300, 200);
          createRed.text = "Create Match (Red)";
          createRed.action = async () => {
              window.playerSide = "red";
              await createMatch();
              destroyMenuButtons();
          };

          let createBlack = templates.copy("UIButton", 300, 280);
          createBlack.text = "Create Match (Black)";
          createBlack.action = async () => {
              window.playerSide = "black";
              await createMatch();
              destroyMenuButtons();
          };

          let join = templates.copy("UIButton", 300, 360);
          join.text = "Join Match";
          join.onclick = () => {
              // Remove or disable buttons to prevent overlap
              createRed.kill = true;
              createBlack.kill = true;
              join.kill = true;

              // Create CT.js-native textbox
              let tb = templates.copy("Textbox", 300, 360);
              tb.placeholder = "Enter Match ID";
              tb.maxLength = 40;
              tb.focus();

              // Optional: console log as player types
              tb.onTextChange = () => {
                  console.log("Current text:", tb.text);
              };

              // Add a submit button next to it
              let submitBtn = templates.copy("UIButton", 500, 360);
              submitBtn.text = "Join";
              submitBtn.onclick = async () => {
                  let id = tb.text.trim();
                  if (id) {
                      console.log("Joining match:", id);
                      await joinMatch(id);
                      tb.kill = true;
                      submitBtn.kill = true;
                  } else {
                      console.log("No match ID entered!");
                  }
              };
          };


          window.menuButtons = [createRed, createBlack, join];

          function destroyMenuButtons() {
              window.menuButtons.forEach(btn => btn.kill = true);
          }
        arguments: {}
        lib: core
