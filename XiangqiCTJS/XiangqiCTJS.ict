              // Cancel dragging on release, even if the event occured outside this tile
              this.dragging = false;
              // Check if we need to snap to the grid.
              if (this.x !== this.x % 64 ||
                  this.y !== this.y % 64
              ) {
                  // Smoothly move to snap to the grid
                  tween.add({
                      obj: this,
                      fields: {
                          x: Math.round(this.x / 64) * 64,
                          y: Math.round(this.y / 64) * 64
                      },
                      duration: 250,
                      silent: true
                  });
              }
          }
